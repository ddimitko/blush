<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Define properties for log file paths and patterns -->
    <springProfile name="!production">
        <property name="LOG_PATH" value="logs"/>
    </springProfile>
    <springProfile name="production">
        <property name="LOG_PATH" value="/app/logs"/>
    </springProfile>
    
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-},%X{spanId:-}] %logger{36} - %msg%n"/>
    <property name="AUDIT_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} - %msg%n"/>

    <!-- Console appender for development -->
    <springProfile name="!production,!test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-},%X{spanId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!-- Console appender for test environment (simplified) -->
    <springProfile name="test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
    </springProfile>

    <!-- File appender for application logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/lunara.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/lunara.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Separate appender for audit logs -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/audit.log</file>
        <encoder>
            <pattern>${AUDIT_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Separate appender for error logs -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/error.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>60</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Separate appender for security logs -->
    <appender name="SECURITY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/security.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/security.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Async appenders for better performance -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <appender name="ASYNC_AUDIT" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="AUDIT_FILE"/>
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- Logger configurations -->
    
    <!-- Audit logger -->
    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="ASYNC_AUDIT"/>
    </logger>

    <!-- Security logger -->
    <logger name="com.ddimitko.beautyhub.security" level="INFO" additivity="false">
        <appender-ref ref="SECURITY_FILE"/>
        <springProfile name="!production">
            <appender-ref ref="CONSOLE"/>
        </springProfile>
    </logger>

    <!-- Application loggers -->
    <logger name="com.ddimitko.beautyhub" level="DEBUG" additivity="false">
        <appender-ref ref="ASYNC_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <springProfile name="!production">
            <appender-ref ref="CONSOLE"/>
        </springProfile>
    </logger>

    <!-- Spring Framework loggers - Production -->
    <springProfile name="production">
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="org.springframework.web" level="WARN"/>
        <logger name="org.springframework.cache" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>
    </springProfile>

    <!-- Spring Framework loggers - Development -->
    <springProfile name="!production">
        <logger name="org.springframework" level="INFO"/>
        <logger name="org.springframework.security" level="DEBUG"/>
        <logger name="org.springframework.web" level="DEBUG"/>
        <logger name="org.springframework.cache" level="DEBUG"/>
        <logger name="org.hibernate" level="INFO"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE"/>
    </springProfile>

    <!-- Redis loggers -->
    <logger name="org.springframework.data.redis" level="INFO"/>
    <logger name="io.lettuce" level="WARN"/>

    <!-- RabbitMQ loggers -->
    <logger name="org.springframework.amqp" level="INFO"/>
    <logger name="org.springframework.rabbit" level="INFO"/>

    <!-- WebSocket loggers - Production -->
    <springProfile name="production">
        <logger name="org.springframework.messaging" level="WARN"/>
        <logger name="org.springframework.web.socket" level="WARN"/>
    </springProfile>

    <!-- WebSocket loggers - Development -->
    <springProfile name="!production">
        <logger name="org.springframework.messaging" level="INFO"/>
        <logger name="org.springframework.web.socket" level="DEBUG"/>
    </springProfile>

    <!-- Stripe loggers -->
    <logger name="com.stripe" level="INFO"/>

    <!-- Micrometer/Metrics loggers -->
    <logger name="io.micrometer" level="INFO"/>

    <!-- Third-party loggers -->
    <logger name="com.fasterxml.jackson" level="WARN"/>
    <logger name="org.apache.http" level="WARN"/>
    <logger name="org.apache.tomcat" level="INFO"/>
    <logger name="org.eclipse.jetty" level="INFO"/>

    <!-- Root logger -->
    <springProfile name="production">
        <root level="WARN">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>
    <springProfile name="!production">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>

    <!-- Conditional configuration for different environments -->
    <springProfile name="test">
        <!-- Reduce logging in test environment -->
        <logger name="com.ddimitko.beautyhub" level="WARN"/>
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Development-specific configuration -->
    <springProfile name="dev,development,local">
        <!-- More verbose logging for development -->
        <logger name="com.ddimitko.beautyhub.service" level="DEBUG"/>
        <logger name="com.ddimitko.beautyhub.controller" level="DEBUG"/>
        <logger name="com.ddimitko.beautyhub.repository" level="DEBUG"/>
    </springProfile>

    <!-- Production-specific configuration -->
    <springProfile name="production">
        <!-- Minimal logging for production performance -->
        <logger name="com.ddimitko.beautyhub.service" level="INFO"/>
        <logger name="com.ddimitko.beautyhub.controller" level="INFO"/>
        <logger name="com.ddimitko.beautyhub.repository" level="WARN"/>
        
        <!-- Ensure sensitive operations are logged -->
        <logger name="com.ddimitko.beautyhub.service.PaymentService" level="INFO"/>
        <logger name="com.ddimitko.beautyhub.service.UserService" level="INFO"/>
        <logger name="com.ddimitko.beautyhub.service.AuditLoggingService" level="INFO"/>
    </springProfile>

</configuration>
